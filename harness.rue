//
// harness.rue
//
// Concept draft for embedding Rueter AI harnesses into Rue.
//
// Implementation target:
// - ai ModelName { ... } compiles to a RueterModel-backed RueAIModel wrapper.
// - harness Name(input) { ... } compiles to an async function.
// - ModelName(value) calls await ModelName.prompt(value).
// - each values with ModelName runs that model once per array item.
// - returns controls response parsing after RueterModel.prompt() returns text.
//

ai Breakdown {
    provider: openai
    apiKey: env("OPENAI_API_KEY")
    model: "gpt-5-mini"
    temperature: 0.2
    maxTokens: 1024
    returns: string[]
    system: `
        Break the user's question into the smallest useful set of subquestions.
        Return only a JSON array of strings.
    `
}

ai SubQuestion {
    provider: openai
    apiKey: env("OPENAI_API_KEY")
    model: "gpt-5-mini"
    temperature: 0.1
    maxTokens: 512
    returns: string
    system: `
        Answer one subquestion accurately and concisely.
        Return only the answer text.
    `
}

ai Summary {
    provider: openai
    apiKey: env("OPENAI_API_KEY")
    model: "gpt-5-mini"
    temperature: 0.25
    maxTokens: 1024
    returns: string
    system: `
        Answer the original question using the solved subquestions.
        Return a direct, complete answer.
    `
}

harness QuestionSolver(question) {
    string[] questions = Breakdown(question)

    string[] answers = each questions with SubQuestion

    string final = Summary({
        question
        answers
    })

    return final
}

@state inputVal = ""
@state promptRes = ""
@state promptLoading = false
@state promptError = ""

component QuestionHarnessDemo() {
    content: [
        new Input({
            placeholder: "Ask a question"
            bind-value: @inputVal
        })

        new Button("Ask", {
            onclick: async () => {
                @promptLoading = true
                @promptError = ""

                try {
                    @promptRes = await QuestionSolver(@inputVal)
                } catch (error) {
                    @promptError = error instanceof Error ? error.message : String(error)
                }

                @promptLoading = false
            }
        })

        new UIElement({
            content: () => {
                if (@promptLoading) return "Thinking..."
                if (@promptError) return @promptError
                return @promptRes
            }
        })
    ]
}

Interface {
    QuestionHarnessDemo()
}
