//
// Landing Page
//
// Rue Programming Language
//

{
    let randomVar = "random"
}

component NameHeroSection() {
    display: grid
    gap: 1rem
    margin-block: 20rem
    padding-inline: 3rem
    content: [
        new Wrapper("Software Engineer", {
            font-size: 0.8rem 
            font-weight: 500
            letter-spacing: 0.6pt
            text-transform: uppercase
            color: hsl(260, 100%, 70%)
        })
        new Wrapper("Aaron Meche", {
            font-size: 4.5rem
            font-weight: 1000
            letter-spacing: -2pt
        })
        new Wrapper("Senior @ Louisiana State University · c/o 2026", {
            font-size: 1.2rem
            font-weight: 300
            opacity: 0.75
        })
        new Wrapper("Lake Charles, LA", {
            font-size: 0.9rem
            font-weight: 500
            opacity: 0.5
        })
    ]
}

// function FeaturedProjects()
component FeaturedProjects() {
    padding: 0 2.4rem
    content: [
        new Wrapper("Featured Projects", {
            font_size: 0.9rem
            font_weight: 600
            opacity: 0.5
        })
        new UIElement({
            display: grid
        })
    ]
}

@state count = 0

component LiveCounter() {
    text-align: center;
    content: [
        new UIElement({
            content: () => {
                return "Live Counter: " + @count
            }
        })
        new Button("+", {
            onclick: () => {
                @count++
            }
        })
    ]
}

Interface {
    NameHeroSection()
    FeaturedProjects()
    LiveCounter()
}
