//
// Rue Studio Layout
//

import Navigation from "./components/navigation.rue"
import Footer from "./components/footer.rue"

def page-bg: #05070d
def page-bg-soft: #080b12
def ink: #f7f8ff
def muted: rgb(229 233 245 / 68%)
def faint: rgb(229 233 245 / 44%)
def line: rgb(229 233 245 / 13%)
def panel: rgb(10 14 24 / 72%)
def panel-strong: rgb(13 18 31 / 88%)
def rose: #ff5d66
def rose-soft: #ff9aa3
def cyan: #31e6d1
def gold: #f4bd61

*{
    box-sizing: border-box
}

html{
    scroll-behavior: smooth
    scroll-padding-top: 6.4rem
    background: var(--page-bg)
}

[id]{
    scroll-margin-top: 6.4rem
}

body{
    margin: 0
    min-height: 100vh
    background: radial-gradient(circle at 50% 4%, rgb(255 93 102 / 24%), transparent 28rem), radial-gradient(circle at 16% 18%, rgb(255 93 102 / 11%), transparent 36rem), radial-gradient(circle at 88% 22%, rgb(49 230 209 / 10%), transparent 34rem), radial-gradient(circle at 50% 82%, rgb(244 189 97 / 8%), transparent 38rem), linear-gradient(180deg, #05070d 0%, #080b12 44%, #05060a 100%)
    color: var(--ink)
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif
    letter-spacing: 0
    overflow-x: hidden
}

body::before{
    content: ""
    position: fixed
    inset: 0
    z-index: 0
    pointer-events: none
    background-image: radial-gradient(circle, rgb(255 255 255 / 68%) 0 1px, transparent 1.8px), radial-gradient(circle, rgb(49 230 209 / 45%) 0 1px, transparent 1.8px), radial-gradient(circle, rgb(255 93 102 / 36%) 0 1px, transparent 1.8px)
    background-size: 148px 176px, 233px 257px, 389px 421px
    background-position: 0 0, 64px 72px, 122px 34px
    opacity: 0.42
}

body::after{
    content: ""
    position: fixed
    inset: 0
    z-index: 0
    pointer-events: none
    background: linear-gradient(180deg, rgb(5 7 13 / 20%), rgb(5 7 13 / 72%) 72%, #05070d 100%)
}

body > *{
    position: relative
    z-index: 1
}

a{
    color: inherit
    text-decoration: none
}

button{
    border: none
    font: inherit
}

textarea{
    font: inherit
}

::selection{
    background: var(--cyan)
    color: #03100f
}

Interface {
    Navigation()
    Interface
    Footer()
}
