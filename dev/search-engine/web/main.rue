function getColor(layer, opacity) {
    let hue = 264
    let strtSat = 28
    let diffSat = 3
    let strtLight = 8
    let diffLight = 4
    let alpha = opacity ?? 1
    return `hsl(${hue} ${strtSat + diffSat * layer}% ${strtLight + diffLight * layer}% / ${alpha})`
}

def bg: getColor(0)
def bg-soft: hsl(266 30% 11% / 1)
def bg-wash: hsl(269 38% 15% / 1)
def surface: hsl(264 26% 14% / 0.9)
def surface-strong: hsl(264 24% 18% / 1)
def surface-muted: hsl(263 22% 22% / 0.82)
def border: hsl(263 20% 29% / 1)
def border-strong: hsl(263 26% 42% / 1)
def text: hsl(262 42% 96% / 1)
def text-soft: hsl(263 26% 84% / 1)
def muted: hsl(263 16% 67% / 1)
def accent: hsl(263 76% 76% / 1)
def accent-hover: hsl(263 88% 83% / 1)
def accent-soft: hsl(263 36% 24% / 1)
def focus: hsl(263 96% 72% / 0.46)
def success: hsl(158 58% 62% / 1)
def warning: hsl(42 96% 66% / 1)
def danger: hsl(350 84% 72% / 1)
def shadow: hsl(264 60% 4% / 0.46)
def l0: var(--bg)
def l1: var(--surface)


body {
    margin: 0
    min-height: 100vh
    background: var(--bg)
    color: var(--text)
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif
}

* {
    box-sizing: border-box
}

::selection {
    background: var(--accent-soft)
    color: var(--text)
}



Interface {
    new UIElement({
        padding: 1.2rem
        border-bottom: solid 1pt var(--surface)
        content: [
            "Search Bar",
        ]
    })
}
