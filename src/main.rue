//
// Rue Programming Language
//

body{
    margin: 0
    background: black
}

Interface {
    new UIElement({
        margin: 2rem auto
        width: 30rem
        padding: 1.2rem
        background: black
        color: white
        border_radius: 0.8rem
        box_shadow: 0 0 10rem black
        content: [
            new Wrapper("Welcome to RueUI!", {
                margin_bottom: 0.8rem
                font_size: 2.4rem
                font_weight: 500
            })
            new Wrapper("Born from the combination of both Rue Lang and GingerUI, RueUI is a powerful, lightweight, and user-friendly JavaScript powered UI engine.", {
                font_size: 1.2rem
                font_weight: 500
                line_height: 1.4
            })
        ]
    })
}