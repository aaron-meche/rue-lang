_hue_: 175

func getAccentDeriv(sat, light) {
    return "hsl(" + _hue_ + ", " + sat + "%, " + light + "%)" // keep strings, remove comments
}

_l0_: getAccentDeriv(8, 8) // layer 0 (bg)

.commented{
    background: _l0_ // use layer 0
    content: "https://example.com/a//b" // keep double slash in strings
}
