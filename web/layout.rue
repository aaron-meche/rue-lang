//
// Rue Programming Language
//

function getColor(level, opacity = 1) {
    let hue = 230
    let ssat = 0
    let dsat = 4
    let slgh = 0
    let dlgh = 6
    return `hsl(${hue}, ${ssat + dsat * level}%, ${slgh + dlgh * level}%, ${opacity})`
}

def bg: getColor(0)
def l1: getColor(1)
def l2: getColor(2)
def l3: getColor(3)
def l4: getColor(4)
def l5: getColor(5)
def l6: getColor(6)
def l7: getColor(7)

body{
    margin: 0
    background: var(--bg)
    font-family: Verdana, sans-serif
    color: white
}

.nav-button-wrapper *{
    padding: 0.6rem 1rem
    font-size: 0.75rem
    letter-spacing: 0.24pt
    border-radius: 0.4rem
    transition: background 80ms, opacity 80ms
    opacity: 0.8
    cursor: pointer

    :hover{
        background: var(--l2)
        opacity: 1
    }
}

component NavigationBar() {
    new UIElement({
        display: grid
        grid-template-columns: auto min-content
        align_items: center
        padding: 1.2rem 2.4rem
        border-bottom: solid 1pt var(--l2)
        content: [
            new UIElement({
                display: flex
                align-items: center
                gap: 0.8rem
                font-weight: 600
                content: [
                    new Image("small-pfp.png", {
                        height: 2rem
                        border-radius: 100vh
                    }),
                    "Aaron Meche"
                ]
            }),
            new UIElement({
                className: nav-button-wrapper
                display: flex
                align-items: center
                content: [
                    new Wrapper("Projects"),
                    new Wrapper("Education"),
                    new Wrapper("GitHub"),
                    new Wrapper("LinkedIn")
                ]
            })
        ]
    })
}

Interface {
    NavigationBar()
    Interface
}
