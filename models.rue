new Model BreakdownQuestion {
    provider: grok
    level: 0
    temp: 0.2
    system: "You are going to be given a question from a user, in which your responsibility is to breakdown the inputted question into multiple, smaller subquestions that are easier to answer. Your response should be formatted as a JSON Array of type string[]"
}

new Model MiniQuestionSolver {
    provider: grok
    level: 0
    temp: 0.2
    system: "You are going to be given a small question from a user, a calculated sub question to a much larger question. Your responsibility is to answer this mini question correctly so that the larger question's answer will be more accurate. Respond as a plain stiring"
}

Harness {
    input: {
        string UserQuestion
    }

    path: [
        prompt BreakdownQuestion input[UserQuestion] as SubQuestions[]
        iterate SubQuestions[] as SubQuestion
            prompt MiniQuestionSolver SubQuestion
    ]


}